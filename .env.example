# 이 파일을 .env.local 로 복사한 뒤 값을 채운다.

# Supabase 대시보드 > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# 서버 전용(결제 후 아이템 지급). 절대 NEXT_PUBLIC_ 를 붙이지 말 것.
SUPABASE_SECRET_KEY=sb_secret_xxx

# 토스페이먼츠 결제위젯 테스트 키. 아래는 토스 개발자센터 문서에 공개된 연동용 테스트 키다.
# 내 키를 쓰려면 developers.tosspayments.com > 내 개발정보 에서 '결제위젯 연동 키'를 복사한다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
TOSS_SECRET_KEY=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6
